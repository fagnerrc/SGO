# Frontend build-time env vars (Vite only exposes vars prefixed VITE_ to
# client code — see src/vite-env.d.ts). Copy to .env.local and use the SAME
# project URL/anon key as ../.env.example (the anon key is safe to ship to
# the browser; RLS is what actually protects data, not secrecy of this key).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
