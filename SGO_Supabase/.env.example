# Copy this file to .env and fill in your own Supabase project's values.
# Never commit the real .env file or real keys.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is only ever used server-side (Edge Functions), never in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings -> API -> JWT Secret. Used only by the pin-login Edge
# Function to sign session tokens; set it with `supabase secrets set`, never
# put the real value in this file or any committed file.
SUPABASE_JWT_SECRET=your-jwt-secret
