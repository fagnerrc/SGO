# Copy this file to .env and fill in your own Supabase project's values.
# Never commit the real .env file or real keys.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key is only ever used server-side (Edge Functions), never in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings -> API -> JWT Secret (or GET /v1/projects/{ref}/postgrest
# via the Management API). Used only by the pin-login Edge Function to sign
# session tokens; set it with `supabase secrets set JWT_SECRET=...`, never
# put the real value in this file or any committed file. Cannot be named
# SUPABASE_JWT_SECRET — Supabase reserves that prefix for its own
# auto-injected vars (SUPABASE_URL/SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY
# above are already auto-injected into every Edge Function; listed here only
# as a reference for other tooling that isn't auto-injected the same way).
JWT_SECRET=your-jwt-secret
